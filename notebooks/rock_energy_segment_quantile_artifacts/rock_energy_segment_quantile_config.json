{
  "method": "log_pseudo_mse_only_segment_quantile",
  "input_path": "..\\datasets\\united.csv",
  "output_path": "united_rock_energy_segment_quantile.csv",
  "segment_size": 60,
  "rolling_windows": [
    12,
    30,
    60
  ],
  "rolling_min_periods": "max(3, window // 3)",
  "energy_labels_4": [
    "soft_low_energy",
    "medium_low_energy",
    "medium_high_energy",
    "hard_high_energy"
  ],
  "hardness_score": "zscore(log_pseudo_mse)",
  "hardness_score_smooth": "zscore(log1p(pseudo_mse_roll_median_60))",
  "surface_features": [
    "pressure_axis",
    "pressure_rotation",
    "rotation",
    "hardness_score_smooth",
    "pressure_balance",
    "rotation_efficiency",
    "energy_input_proxy"
  ],
  "removed_from_hardness_score": [
    "expected_speed_from_controls",
    "formation_residual",
    "relative_formation_residual",
    "drilling_efficiency"
  ]
}